FROM node:22.15.0-bullseye-slim AS build

WORKDIR /app/src/interface

COPY src/interface/package.json src/interface/package-lock.json ./
RUN npm ci

COPY src/interface/ ./
RUN npm run build -- --configuration docker --output-path=dist/out

FROM nginx:1.27-alpine

COPY docker/frontend/nginx.conf /etc/nginx/templates/default.conf.template
COPY docker/frontend/entrypoint.sh /entrypoint.sh
COPY --from=build /app/src/interface/dist/out/ /usr/share/nginx/html/

RUN chmod +x /entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
